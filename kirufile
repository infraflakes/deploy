(kirufile
  (project deploy
    (fn ssh
      (switch (t (cmd (t (lit "test -f \"$HOME/.ssh/id_ed25519.pub\" && git remote get-url origin 2>/dev/null | grep -q \"^https://\" && echo \"1\"")))) (case "1" (log (t (lit "Switching url source..."))) (run_shell_cmd (t (cmd (t (lit "git remote set-url origin git@github.com:infraflakes/") (lit "deploy") (lit ".git")))))) (case _ (log (t (lit "Source is already switched, or not enough condition.")))))
    )
  )
  (project dots
    (fn init
      (switch (t (cmd (t (lit "test -f ~/.config/fish/config.fish && echo \"1\"")))) (case "1" (log (t (lit "Symlinking with stow..."))) (run_shell_cmd (t (cmd (t (lit "stow --adopt -t ") (cmd (t (lit "echo $HOME"))) (lit "/.config") (lit " config"))))) (run_shell_cmd (t (cmd (t (lit "git restore config/fish")))))) (case _ (log (t (lit "Symlinking with stow..."))) (run_shell_cmd (t (cmd (t (lit "stow -t ") (cmd (t (lit "echo $HOME"))) (lit "/.config") (lit " config")))))))
    )
    (fn remove
      (log (t (lit "Removing stow's symlink...")))
      (run_shell_cmd (t (cmd (t (lit "stow -D -t ") (cmd (t (lit "echo $HOME"))) (lit "/.config") (lit " config")))))
    )
  )
  (project kiru
    (fn build
      (log (t (lit "Building kiru cli!")))
      (run_shell_cmd (t (cmd (t (lit "cargo build --release")))))
    )
    (fn clean
      (log (t (lit "Cleaning up artifacts...")))
      (run_shell_cmd (t (cmd (t (lit "rm -rf bin")))))
      (run_shell_cmd (t (cmd (t (lit "rm -rf result")))))
    )
    (fn container
      (switch (t (cmd (t (lit "command -v docker >/dev/null 2>&1 && echo \"docker\" || { command -v podman >/dev/null 2>&1 && echo \"podman\"; }")))) (case "" (log (t (lit "no container runtime found"))) (run_shell_cmd (t (cmd (t (lit "exit 1")))))) (case _ (log (t (lit "building kiru with ") (cmd (t (lit "command -v docker >/dev/null 2>&1 && echo \"docker\" || { command -v podman >/dev/null 2>&1 && echo \"podman\"; }"))))) (run_shell_cmd (t (cmd (t (cmd (t (lit "command -v docker >/dev/null 2>&1 && echo \"docker\" || { command -v podman >/dev/null 2>&1 && echo \"podman\"; }"))) (lit " build --output type=local,dest=bin .")))))))
    )
    (fn fail
      (log (t (lit "Failing the task!")))
      (env ((CGO_ENABLED (t (lit "0"))) (GOOS (t (lit "linux")))) ((run_shell_cmd (t (cmd (t (lit "go build ./...")))))))
    )
    (fn fmt
      (log (t (lit "Formatting the codebase...")))
      (run_shell_cmd (t (cmd (t (lit "cargo clippy --fix --allow-dirty")))))
      (run_shell_cmd (t (cmd (t (lit "cargo fmt")))))
    )
    (fn ssh
      (switch (t (cmd (t (lit "test -f \"$HOME/.ssh/id_ed25519.pub\" && git remote get-url origin 2>/dev/null | grep -q \"^https://\" && echo \"1\"")))) (case "1" (log (t (lit "Switching url source..."))) (run_shell_cmd (t (cmd (t (lit "git remote set-url origin git@github.com:infraflakes/") (lit "kiru") (lit ".git")))))) (case _ (log (t (lit "Source is already switched, or not enough condition.")))))
    )
    (fn test
      (log (t (lit "Testing the codebase!")))
      (run_shell_cmd (t (cmd (t (lit "cargo test")))))
      (run_shell_cmd (t (cmd (t (lit "cargo clippy -- -D warnings")))))
      (run_shell_cmd (t (cmd (t (lit "cargo fmt --check")))))
    )
    (fn update
      (log (t (lit "Updating dependencies")))
      (run_shell_cmd (t (cmd (t (lit "cargo update")))))
      (run_shell_cmd (t (cmd (t (lit "cargo upgrade")))))
      (run_shell_cmd (t (cmd (t (lit "nix flake update")))))
    )
  )
  (project nix
    (fn eval
      (log (t (lit "Building flake home manager...")))
      (run_shell_cmd (t (cmd (t (lit "home-manager switch --flake .#nixenv@container")))))
    )
    (fn ssh
      (switch (t (cmd (t (lit "test -f \"$HOME/.ssh/id_ed25519.pub\" && git remote get-url origin 2>/dev/null | grep -q \"^https://\" && echo \"1\"")))) (case "1" (log (t (lit "Switching url source..."))) (run_shell_cmd (t (cmd (t (lit "git remote set-url origin git@github.com:infraflakes/") (lit "nixenv") (lit ".git")))))) (case _ (log (t (lit "Source is already switched, or not enough condition.")))))
    )
  )
  (project portfolio
    (fn build
      (cd (t (lit "landing-page")))
      (run_shell_cmd (t (cmd (t (lit "nix develop -c bun install")))))
      (run_shell_cmd (t (cmd (t (lit "nix develop -c bun run build")))))
    )
    (fn fmt
      (cd (t (lit "landing-page")))
      (run_shell_cmd (t (cmd (t (lit "nix develop -c biome format --write .")))))
      (run_shell_cmd (t (cmd (t (lit "nix develop -c biome format .")))))
    )
    (fn lint
      (cd (t (lit "landing-page")))
      (run_shell_cmd (t (cmd (t (lit "nix develop -c biome lint --write .")))))
      (run_shell_cmd (t (cmd (t (lit "nix develop -c biome lint .")))))
    )
    (fn ssh
      (switch (t (cmd (t (lit "test -f \"$HOME/.ssh/id_ed25519.pub\" && git remote get-url origin 2>/dev/null | grep -q \"^https://\" && echo \"1\"")))) (case "1" (log (t (lit "Switching url source..."))) (run_shell_cmd (t (cmd (t (lit "git remote set-url origin git@github.com:infraflakes/") (lit "infraflakes.github.io") (lit ".git")))))) (case _ (log (t (lit "Source is already switched, or not enough condition.")))))
    )
  )
  (run bootstrap (stage (call nix eval) (call dots init)))
  (run build_container_kiru (stage (call kiru container)))
  (run build_kiru (stage (call kiru build)))
  (run ci_kiru (stage (call kiru test)) (stage (call kiru build)))
  (run clean_kiru (stage (call kiru clean)))
  (run eval_nix (stage (call nix eval)))
  (run ssh (stage (call deploy ssh)) (stage (call kiru ssh)) (stage (call nix ssh)) (stage (call portfolio ssh)))
  (run test_kiru (stage (call kiru fmt) (call kiru test)) (stage (call kiru clean) (call kiru build)))
  (run test_portfolio (stage (call portfolio fmt)) (stage (call portfolio lint)) (stage (call portfolio build)))
  (run update_kiru (stage (call kiru update)))
)
