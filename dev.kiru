var shell workdir = `echo $HOME/Projects`;
var shell confdir= `echo $HOME/.config`;

var string kiru_dir = `${global::workdir}/kiru`;
pr kiru [
  url = `git@github.com:infraflakes/kiru.git`
  dir = $global::kiru_dir
  sync = `clone`
  branch = `dev`
] {}
import `${global::kiru_dir}/main.kiru`;

pr portfolio [
  url = `git@github.com:infraflakes/infraflakes.github.io.git`
  dir = `${global::workdir}/portfolio`
  sync = `clone`
] {}
import `${global::workdir}/portfolio/main.kiru`;
